#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <400>;
            require-prior-idle-ms = <400>;
            flavor = "tap-preferred";
        };

        q_tapdance: q_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "Q_TAPDANCE";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp DEL>;
        };

        numkey_toggle: numkey_toggle {
            compatible = "zmk,behavior-key-toggle";
            label = "NUMKEY_TOGGLE";
            #binding-cells = <1>;
            toggle-mode = "on";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &q_tapdance     &kp W           &kp E         &kp R               &kp T        &kp Y      &kp U                &kp I              &kp O            &kp P                    &kp BSPC
&kp GRAVE  &hm LEFT_WIN A  &hm LEFT_ALT S  &hm LSHIFT D  &hm LEFT_CONTROL F  &kp G        &kp H      &hm RIGHT_CONTROL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_WIN SEMICOLON  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C         &kp V               &kp B        &kp N      &kp M                &kp COMMA          &kp DOT          &kp FSLH                 &kp ESC
                                           &kp LGUI      &mo 1               &kp ENTER    &kp SPACE  &mo 2                &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp N1  &kp N2    &kp N3        &kp N4     &kp N5       &kp N6     &kp N7    &kp N8    &kp N9     &kp N0    &kp BSPC
&kp LCTRL  &kp A   &kp F2    &kp UP        &trans     &kp A        &trans     &trans    &kp UP    &trans     &kp HOME  &kp PG_UP
&tog 3     &tog 0  &kp LEFT  &kp DOWN      &kp RIGHT  &kp DEL      &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp END   &kp PG_DN
                             &kp LEFT_WIN  &trans     &kp ENTER    &kp SPACE  &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT          &kp HASH        &kp DLLR         &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&tog 0     &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                     &kp LGUI        &trans           &kp ENTER    &kp SPACE  &trans     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp TAB  &trans  &trans    &trans    &trans     &trans       &trans     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp FSLH   &kp BSPC
&trans   &trans  &trans    &kp UP    &trans     &trans       &trans     &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp PLUS   &kp KP_DOT
&to 0    &to 0   &kp LEFT  &kp DOWN  &kp RIGHT  &kp A        &kp KP_N0  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp MINUS  &kp ASTRK
                           &trans    &mo 1      &kp ENTER    &kp ENTER  &mo 2      &kp KP_N0
            >;
        };
    };
};
